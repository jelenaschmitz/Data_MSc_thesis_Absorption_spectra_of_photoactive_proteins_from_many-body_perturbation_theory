&GLOBAL
  PROJECT  System_with_cut_cell_test
  PRINT_LEVEL MEDIUM
  RUN_TYPE ENERGY
  !TRACE TRUE
  &TIMINGS
    TIMINGS_LEVEL 1
    THRESHOLD 2.00000000E-006
  &END TIMINGS
  EXTENDED_FFT_LENGTHS TRUE
&END GLOBAL
&FORCE_EVAL
  METHOD Quickstep
  &DFT
    CHARGE 9669
    BASIS_SET_FILE_NAME  Basis_Sets_Version_03_09_2025-aug
    POTENTIAL_FILE_NAME POTENTIAL
    &MGRID
      CUTOFF  500
      REL_CUTOFF  50
    &END MGRID
    &QS
      METHOD GPW
    &END QS
    &POISSON
      PERIODIC NONE
      PSOLVER MULTIPOLE
    &END
    &SCF
       SCF_GUESS RESTART
       EPS_SCF 1e-7
       MAX_SCF 10
       &OT
          MINIMIZER CG
          PRECONDITIONER FULL_SINGLE_INVERSE
       &END OT
       &OUTER_SCF
          EPS_SCF 1e-7
          MAX_SCF 50
       &END OUTER_SCF
      &PRINT
        &RESTART ON
        &END
      &END
      &MIXING
          METHOD BROYDEN_MIXING
          ALPHA 0.1
          BETA 1.5
          NBROYDEN 8
      &END
    &END SCF
	&XC
	    &XC_FUNCTIONAL PBE
	    &END XC_FUNCTIONAL
      &WF_CORRELATION
        &RI_RPA
          QUADRATURE_POINTS 100
          &GW
           NPARAM_PADE 16
           SELF_CONSISTENCY EVGW0
           &BSE
             TDA TDA+ABBA
             NUM_PRINT_EXC 50
		NUM_PRINT_EXC_DESCR -1
             ENERGY_CUTOFF_EMPTY 20
             ENERGY_CUTOFF_OCC 20
             &BSE_SPECTRUM 
              ETA_LIST 0.01, 0.05, 0.1, 0.2, 0.25
              FREQUENCY_STEP_SIZE 0.001
             &END BSE_SPECTRUM
           &END BSE
          &END GW
        &END RI_RPA
      &END
  &END XC
  &END DFT
  &SUBSYS
    &CELL
      ABC 66 66 66
      PERIODIC NONE
    &END CELL
    &TOPOLOGY
      &CENTER_COORDINATES
        CENTER_POINT  0.17343699999999984 6.268078000000001 -5.962776
      &END
      COORD_FILE_NAME 6YMU_E_new_cut_script_box_length_25_dis_to_counter_5_vacuum_3_only_monopole_zero.XYZ
      COORD_FILE_FORMAT XYZ
    &END TOPOLOGY
